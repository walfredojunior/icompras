# ===== Banco (MariaDB 12.1 local, porta 3307) =====
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=icompras_app
DB_PASSWORD=troque-aqui
DB_NAME=icompras

# ===== Busca (Meilisearch) =====
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=troque-aqui

# ===== Fila (Redis) =====
REDIS_URL=redis://127.0.0.1:6379

# ===== Camada de IA (configurável) =====
# provedores: claude | openai
AI_PROVIDER=claude
AI_API_KEY=
# embeddings — a dimensão precisa bater com a coluna VECTOR do banco (1024)
# embeddings: local (sem chave, padrão) | voyage | openai
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=local-hash
EMBEDDING_DIM=1024
# distância máxima (cosseno) para agrupar produtos como iguais
DEDUP_THRESHOLD=0.35

# ===== Pagamentos (configurável) =====
# provedores: bancard | pagopar
PAYMENT_PROVIDER=bancard
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
PAGOPAR_PUBLIC_TOKEN=
PAGOPAR_PRIVATE_TOKEN=

# ===== Notificações (configurável) =====
# email: smtp | resend | ses ; whatsapp: cloud-api
EMAIL_PROVIDER=smtp
WHATSAPP_PROVIDER=cloud-api

# ===== Armazenamento de imagens =====
# storage: local | s3 | r2
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=icompras
S3_ACCESS_KEY=
S3_SECRET_KEY=
